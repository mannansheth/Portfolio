PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5175
# Optional comma-separated additional frontend origins (for example, phone access on your LAN)
FRONTEND_ORIGINS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio
DB_PASSWORD=
DB_NAME=portfolio
NODE_ENV=development
# Temporary public HTTP only: set to 0 to disable the Secure session-cookie flag.
# Remove the override after HTTPS is enabled; production defaults to Secure cookies.
# COOKIE_SECURE=0
# Set to 1 only after the public site is available over HTTPS.
FORCE_HTTPS=0
# Optional: higher public limits and private imports; selected repos, Contents read-only
GITHUB_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional fallback for temporary provider failures; blank disables fallback
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=
CONTACT_FROM=
# Set to 1 only behind one trusted reverse proxy that overwrites/appends the client address.
# Required for visitor geolocation when the app is behind Apache.
TRUST_PROXY=0
# Optional local MaxMind GeoLite2 City database. On EC2, place the file in
# /etc/portfolio/geoip/GeoLite2-City.mmdb; the deploy workflow mounts it read-only.
GEOIP_DB_PATH=/opt/geoip/GeoLite2-City.mmdb
# Analytics record retention, 30-365 days (default 180)
ANALYTICS_RETENTION_DAYS=180
