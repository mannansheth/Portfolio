PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional comma-separated additional frontend origins (for example, phone access on your LAN)
FRONTEND_ORIGINS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio
DB_PASSWORD=
DB_NAME=portfolio
NODE_ENV=development
# Optional: higher public limits and private imports; selected repos, Contents read-only
GITHUB_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional fallback for temporary provider failures; blank disables fallback
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=
CONTACT_FROM=
# Set to 1 only behind a trusted reverse proxy
TRUST_PROXY=0
